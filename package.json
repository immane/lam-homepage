{
  "name": "lam-homepage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "turbo run dev --filter=@lam/web",
    "build": "turbo run build",
    "build:static": "turbo run build:static --filter=@lam/web",
    "build:guest": "turbo run build:guest --filter=@lam/finder",
    "start": "turbo run start --filter=@lam/web",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "sim:assets": "pnpm --filter @lam/sim-vm sync-assets"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
